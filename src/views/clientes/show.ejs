<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-lg shadow">
        <div class="p-6 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg font-semibold">Detalle del Cliente</h3>
            <div class="flex gap-2">
                <a href="/clientes/<%= cliente.id %>/editar" class="bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded-lg transition text-sm">
                    <i class="fas fa-edit mr-2"></i>Editar
                </a>
                <a href="/clientes" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg transition text-sm">
                    Volver
                </a>
            </div>
        </div>
        
        <div class="p-6">
            <div class="flex items-center gap-4 mb-6">
                <div class="h-16 w-16 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-2xl font-bold">
                    <%= cliente.nombre.charAt(0).toUpperCase() %>
                </div>
                <div>
                    <h2 class="text-xl font-bold text-gray-800"><%= cliente.nombre %></h2>
                    <span class="inline-block mt-1 <%= cliente.activo ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %> text-xs px-3 py-1 rounded-full font-medium">
                        <%= cliente.activo ? 'Activo' : 'Inactivo' %>
                    </span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-gray-50 p-4 rounded-lg">
                    <p class="text-sm text-gray-500 mb-1"><i class="fas fa-id-card w-5"></i>Documento</p>
                    <p class="font-medium">
                        <% if (cliente.tipo_documento === 'DNI') { %>
                            <span class="bg-purple-100 text-purple-800 text-xs px-2 py-1 rounded-full font-medium mr-1">DNI</span>
                            <%= cliente.dni || 'No especificado' %>
                        <% } else { %>
                            <span class="bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded-full font-medium mr-1">RUC</span>
                            <%= cliente.ruc || 'No especificado' %>
                        <% } %>
                    </p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                    <p class="text-sm text-gray-500 mb-1"><i class="fas fa-user w-5"></i>Contacto</p>
                    <p class="font-medium"><%= cliente.contacto || 'No especificado' %></p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                    <p class="text-sm text-gray-500 mb-1"><i class="fas fa-phone w-5"></i>Teléfono</p>
                    <p class="font-medium"><%= cliente.telefono || 'No especificado' %></p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                    <p class="text-sm text-gray-500 mb-1"><i class="fas fa-envelope w-5"></i>Email</p>
                    <p class="font-medium"><%= cliente.email || 'No especificado' %></p>
                </div>
                <div class="md:col-span-2 bg-gray-50 p-4 rounded-lg">
                    <p class="text-sm text-gray-500 mb-1"><i class="fas fa-map-marker-alt w-5"></i>Dirección</p>
                    <p class="font-medium"><%= cliente.direccion || 'No especificada' %></p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                    <p class="text-sm text-gray-500 mb-1"><i class="fas fa-calendar w-5"></i>Registrado</p>
                    <p class="font-medium"><%= new Date(cliente.created_at).toLocaleDateString('es-PE') %></p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                    <p class="text-sm text-gray-500 mb-1"><i class="fas fa-clock w-5"></i>Actualizado</p>
                    <p class="font-medium"><%= new Date(cliente.updated_at).toLocaleDateString('es-PE') %></p>
                </div>
            </div>
        </div>
    </div>
</div>