<div class="max-w-4xl mx-auto px-4 md:px-0">
    <div class="bg-white rounded-lg shadow">
        <!-- Header -->
        <div class="p-4 md:p-6 border-b border-gray-200 flex flex-col md:flex-row md:justify-between md:items-center gap-4">
            <div>
                <h3 class="text-lg font-semibold">Proforma <%= proforma.numero %></h3>
                <p class="text-sm text-gray-500 mt-1">
                    Emitida el <%= new Date(proforma.fecha_emision).toLocaleDateString('es-PE', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                </p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="/proformas/<%= proforma.id %>/editar" class="bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded-lg transition text-sm flex items-center">
                    <i class="fas fa-edit mr-2"></i>Editar
                </a>
                <a href="/reportes/proforma/<%= proforma.id %>/pdf" target="_blank" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg transition text-sm flex items-center">
                    <i class="fas fa-file-pdf mr-2"></i>PDF
                </a>
                <form action="/proformas/<%= proforma.id %>/estado" method="POST" class="inline">
                    <select name="estado" onchange="this.form.submit()" 
                        class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none bg-white">
                        <option value="EMITIDA" <%= proforma.estado === 'EMITIDA' ? 'selected' : '' %>>EMITIDA</option>
                        <option value="ENVIADA" <%= proforma.estado === 'ENVIADA' ? 'selected' : '' %>>ENVIADA</option>
                        <option value="ACEPTADA" <%= proforma.estado === 'ACEPTADA' ? 'selected' : '' %>>ACEPTADA</option>
                        <option value="RECHAZADA" <%= proforma.estado === 'RECHAZADA' ? 'selected' : '' %>>RECHAZADA</option>
                        <option value="ANULADA" <%= proforma.estado === 'ANULADA' ? 'selected' : '' %>>ANULADA</option>
                    </select>
                </form>
                <a href="/proformas" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg transition text-sm flex items-center">
                    Volver
                </a>
            </div>
        </div>
        
        <div class="p-4 md:p-6">
            <!-- Datos del Cliente -->
            <div class="bg-gray-50 rounded-lg p-4 mb-6">
                <h4 class="font-semibold text-gray-700 mb-3 text-sm md:text-base">Cliente</h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <p class="text-xs md:text-sm text-gray-500">Razón Social</p>
                        <p class="font-medium text-sm md:text-base"><%= proforma.cliente_nombre %></p>
                    </div>
                    <div>
                        <p class="text-xs md:text-sm text-gray-500"><%= proforma.cliente_documento_label || 'RUC' %></p>
                        <p class="font-medium text-sm md:text-base"><%= proforma.cliente_documento || '-' %></p>
                    </div>
                    <div>
                        <p class="text-xs md:text-sm text-gray-500">Dirección</p>
                        <p class="font-medium text-sm md:text-base"><%= proforma.cliente_direccion || '-' %></p>
                    </div>
                    <div>
                        <p class="text-xs md:text-sm text-gray-500">Teléfono</p>
                        <p class="font-medium text-sm md:text-base"><%= proforma.cliente_telefono || '-' %></p>
                    </div>
                    <% if (proforma.cliente_contacto) { %>
                    <div class="sm:col-span-2">
                        <p class="text-xs md:text-sm text-gray-500">Contacto</p>
                        <p class="font-medium text-sm md:text-base"><%= proforma.cliente_contacto %></p>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- Tabla de Detalles -->
            <div class="overflow-x-auto -mx-4 md:mx-0 mb-6">
                <table class="w-full min-w-[500px] md:min-w-0">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-3 md:px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">N°</th>
                            <th class="px-3 md:px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Descripción</th>
                            <th class="px-3 md:px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Cant.</th>
                            <th class="px-3 md:px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">P. Unit.</th>
                            <th class="px-3 md:px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Total</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <% proforma.detalles.forEach((d, i) => { %>
                        <tr>
                            <td class="px-3 md:px-4 py-3 text-sm text-gray-600"><%= i + 1 %></td>
                            <td class="px-3 md:px-4 py-3 text-sm text-gray-900"><%= d.descripcion %></td>
                            <td class="px-3 md:px-4 py-3 text-sm text-gray-600 text-right"><%= d.cantidad %></td>
                            <td class="px-3 md:px-4 py-3 text-sm text-gray-600 text-right">S/ <%= Number(d.precio_unitario).toFixed(2) %></td>
                            <td class="px-3 md:px-4 py-3 text-sm text-gray-900 text-right font-medium">S/ <%= Number(d.total).toFixed(2) %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <!-- Totales -->
            <div class="flex justify-end mb-6">
                <div class="w-full sm:w-64 space-y-2 bg-gray-50 p-4 rounded-lg">
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-600">Subtotal:</span>
                        <span class="font-medium">S/ <%= Number(proforma.subtotal).toFixed(2) %></span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-600">IGV (18%):</span>
                        <span class="font-medium">S/ <%= Number(proforma.igv).toFixed(2) %></span>
                    </div>
                    <div class="flex justify-between text-lg font-bold border-t pt-2">
                        <span>Total:</span>
                        <span class="text-blue-600">S/ <%= Number(proforma.total).toFixed(2) %></span>
                    </div>
                </div>
            </div>

            <!-- Observaciones -->
            <% if (proforma.observaciones) { %>
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                <p class="text-sm font-medium text-yellow-800 mb-1">Observaciones:</p>
                <p class="text-sm text-yellow-700"><%= proforma.observaciones %></p>
            </div>
            <% } %>
        </div>
    </div>
</div>