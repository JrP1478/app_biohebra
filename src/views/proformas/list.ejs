<div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <form action="/proformas" method="GET" class="flex flex-1 gap-3 flex-wrap">
        <div class="flex-1 relative min-w-[200px]">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <input type="text" name="busqueda" value="<%= busqueda %>"
                placeholder="Buscar por número o cliente..."
                class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
        </div>
        <select name="estado" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none bg-white min-w-[120px]">
            <option value="" <%= filtroEstado === '' ? 'selected' : '' %>>Todos</option>
            <option value="EMITIDA" <%= filtroEstado === 'EMITIDA' ? 'selected' : '' %>>Emitidas</option>
            <option value="ENVIADA" <%= filtroEstado === 'ENVIADA' ? 'selected' : '' %>>Enviadas</option>
            <option value="ACEPTADA" <%= filtroEstado === 'ACEPTADA' ? 'selected' : '' %>>Aceptadas</option>
            <option value="RECHAZADA" <%= filtroEstado === 'RECHAZADA' ? 'selected' : '' %>>Rechazadas</option>
            <option value="ANULADA" <%= filtroEstado === 'ANULADA' ? 'selected' : '' %>>Anuladas</option>
        </select>
        <button type="submit" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg transition">
            Filtrar
        </button>
        <% if (busqueda || filtroEstado) { %>
        <a href="/proformas" class="bg-red-100 hover:bg-red-200 text-red-700 px-4 py-2 rounded-lg transition flex items-center">
            <i class="fas fa-times"></i>
        </a>
        <% } %>
    </form>
    <a href="/proformas/nueva" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition whitespace-nowrap text-center">
        <i class="fas fa-plus mr-2"></i>Nueva Proforma
    </a>
</div>

<!-- VISTA MÓVIL: Cards -->
<div class="md:hidden space-y-4 mb-6">
    <% if (proformas.length > 0) { %>
        <% proformas.forEach(p => { %>
        <div class="bg-white rounded-lg shadow p-4 border-l-4 <%= 
            p.estado === 'EMITIDA' ? 'border-blue-500' :
            p.estado === 'ENVIADA' ? 'border-yellow-500' :
            p.estado === 'ACEPTADA' ? 'border-green-500' :
            p.estado === 'RECHAZADA' ? 'border-red-500' :
            'border-gray-500'
        %>">
            <div class="flex justify-between items-start mb-2">
                <div>
                    <p class="font-bold text-blue-600 text-sm"><%= p.numero %></p>
                    <p class="text-xs text-gray-500"><%= new Date(p.fecha_emision).toLocaleDateString('es-PE') %></p>
                </div>
                <span class="text-xs px-2 py-1 rounded-full font-medium <%= 
                    p.estado === 'EMITIDA' ? 'bg-blue-100 text-blue-800' :
                    p.estado === 'ENVIADA' ? 'bg-yellow-100 text-yellow-800' :
                    p.estado === 'ACEPTADA' ? 'bg-green-100 text-green-800' :
                    p.estado === 'RECHAZADA' ? 'bg-red-100 text-red-800' :
                    'bg-gray-100 text-gray-800'
                %>"><%= p.estado %></span>
            </div>
            <p class="text-sm font-medium text-gray-800 mb-1"><%= p.cliente_nombre %></p>
            <p class="text-xs text-gray-500 mb-3">
                <% if (p.cliente_tipo_documento === 'DNI') { %>
                    DNI: <%= p.cliente_dni || '-' %>
                <% } else { %>
                    RUC: <%= p.cliente_ruc || '-' %>
                <% } %>
            </p>
            <div class="flex justify-between items-center">
                <span class="font-bold text-gray-900">S/ <%= Number(p.total).toFixed(2) %></span>
                <a href="/proformas/<%= p.id %>" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                    Ver <i class="fas fa-arrow-right ml-1"></i>
                </a>
            </div>
        </div>
        <% }); %>
    <% } else { %>
        <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
            <i class="fas fa-file-alt text-4xl mb-3 text-gray-300"></i>
            <p>No se encontraron proformas</p>
        </div>
    <% } %>
</div>

<!-- VISTA DESKTOP: Tabla -->
<div class="hidden md:block bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full min-w-[800px]">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Número</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cliente</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total</th>
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                <% if (proformas.length > 0) { %>
                    <% proformas.forEach(p => { %>
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 font-medium text-blue-600"><%= p.numero %></td>
                        <td class="px-6 py-4">
                            <div class="font-medium text-gray-900"><%= p.cliente_nombre %></div>
                            <div class="text-sm text-gray-500">
                                <% if (p.cliente_tipo_documento === 'DNI') { %>
                                    DNI: <%= p.cliente_dni || '-' %>
                                <% } else { %>
                                    RUC: <%= p.cliente_ruc || '-' %>
                                <% } %>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-600">
                            <%= new Date(p.fecha_emision).toLocaleDateString('es-PE') %>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-900 text-right font-bold">S/ <%= Number(p.total).toFixed(2) %></td>
                        <td class="px-6 py-4 text-center">
                            <% const colores = {
                                'EMITIDA': 'blue',
                                'ENVIADA': 'yellow',
                                'ACEPTADA': 'green',
                                'RECHAZADA': 'red',
                                'ANULADA': 'gray'
                            }; %>
                            <span class="bg-<%= colores[p.estado] %>-100 text-<%= colores[p.estado] %>-800 text-xs px-2 py-1 rounded-full font-medium">
                                <%= p.estado %>
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <a href="/proformas/<%= p.id %>" class="text-blue-600 hover:text-blue-800 p-2" title="Ver">
                                <i class="fas fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                            <i class="fas fa-file-alt text-4xl mb-3 text-gray-300"></i>
                            <p>No se encontraron proformas</p>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
    const buscadorProf = document.getElementById('buscadorProformas');
    const filtroEstadoProf = document.getElementById('filtroEstadoProf');
    const filasProf = document.querySelectorAll('.fila-proforma');
    const sinResultadosProf = document.getElementById('sinResultadosProf');
    const tablaProformas = document.getElementById('tablaProformas');

    function filtrarProf() {
        const texto = buscadorProf.value.toLowerCase().trim();
        const estado = filtroEstadoProf.value;
        let visibles = 0;

        filasProf.forEach(fila => {
            const numero = fila.dataset.numero;
            const cliente = fila.dataset.cliente;
            const ruc = fila.dataset.ruc;
            const estadoFila = fila.dataset.estado;

            const coincideTexto = !texto || numero.includes(texto) || cliente.includes(texto) || ruc.includes(texto);
            const coincideEstado = estado === 'todos' || estadoFila === estado;

            if (coincideTexto && coincideEstado) {
                fila.style.display = '';
                visibles++;
            } else {
                fila.style.display = 'none';
            }
        });

        if (visibles === 0) {
            tablaProformas.style.display = 'none';
            sinResultadosProf.style.display = '';
        } else {
            tablaProformas.style.display = '';
            sinResultadosProf.style.display = 'none';
        }
    }

    buscadorProf.addEventListener('input', filtrarProf);
    filtroEstadoProf.addEventListener('change', filtrarProf);

    buscadorProf.focus();
</script>