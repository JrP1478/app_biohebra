<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-lg shadow">
        <div class="p-6 border-b border-gray-200">
            <h3 class="text-lg font-semibold"><%= modo === 'crear' ? 'Nuevo' : 'Editar' %> Producto</h3>
        </div>
        
        <form action="<%= modo === 'crear' ? '/productos/nuevo' : '/productos/' + producto.id + '/editar' %>" method="POST" class="p-6">
            <% if (errores.length > 0) { %>
            <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
                <ul class="list-disc list-inside text-red-700 text-sm">
                    <% errores.forEach(error => { %>
                        <li><%= error.msg %></li>
                    <% }); %>
                </ul>
            </div>
            <% } %>

            <div class="space-y-6 mb-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nombre del Producto *</label>
                    <input type="text" name="nombre" required value="<%= producto.nombre || '' %>"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Descripción</label>
                    <textarea name="descripcion" rows="3"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none resize-none"><%= producto.descripcion || '' %></textarea>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Precio Base (S/) *</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">S/</span>
                        <input type="number" name="precio_base" step="0.01" min="0" required
                            value="<%= producto.precio_base || '' %>"
                            class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
                    </div>
                </div>
            </div>

            <div class="flex gap-4">
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition">
                    <i class="fas fa-save mr-2"></i>Guardar
                </button>
                <a href="/productos" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-6 py-2 rounded-lg transition">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>