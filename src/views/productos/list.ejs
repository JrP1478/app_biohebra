<div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div class="flex flex-1 gap-3 flex-wrap">
        <div class="flex-1 relative min-w-[200px]">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <input type="text" id="buscadorProductos" 
                placeholder="Buscar por nombre o descripción..."
                class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
        </div>
        <select id="filtroActivoProd" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none bg-white min-w-[120px]">
            <option value="todos">Todos</option>
            <option value="activo">Activos</option>
            <option value="inactivo">Inactivos</option>
        </select>
    </div>
    <a href="/productos/nuevo" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition whitespace-nowrap text-center">
        <i class="fas fa-plus mr-2"></i>Nuevo Producto
    </a>
</div>

<!-- VISTA MÓVIL: Cards -->
<div class="md:hidden space-y-4 mb-6">
    <% if (productos.length > 0) { %>
        <% productos.forEach(producto => { %>
        <div class="bg-white rounded-lg shadow p-4 border-l-4 <%= 
            producto.activo ? 'border-green-500' : 'border-red-500'
        %>">
            <div class="flex justify-between items-start mb-2">
                <div class="flex items-center">
                    <div class="h-10 w-10 rounded-lg bg-purple-100 flex items-center justify-center text-purple-600 font-bold mr-3">
                        <i class="fas fa-box"></i>
                    </div>
                    <div>
                        <p class="font-bold text-gray-900 text-sm"><%= producto.nombre %></p>
                        <p class="text-xs text-gray-500 truncate max-w-[150px]"><%= producto.descripcion || 'Sin descripción' %></p>
                    </div>
                </div>
                <span class="text-xs px-2 py-1 rounded-full font-medium <%= 
                    producto.activo ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                %>">
                    <%= producto.activo ? 'Activo' : 'Inactivo' %>
                </span>
            </div>
            
            <div class="flex justify-between items-center mb-3">
                <span class="text-sm text-gray-500">Precio Base</span>
                <span class="font-bold text-gray-900">S/ <%= Number(producto.precio_base).toFixed(2) %></span>
            </div>
            
            <div class="flex justify-end gap-2 pt-2 border-t border-gray-100">
                <a href="/productos/<%= producto.id %>" class="text-blue-600 hover:text-blue-800 p-2" title="Ver">
                    <i class="fas fa-eye"></i>
                </a>
                <a href="/productos/<%= producto.id %>/editar" class="text-yellow-600 hover:text-yellow-800 p-2" title="Editar">
                    <i class="fas fa-edit"></i>
                </a>
                <form action="/productos/<%= producto.id %>/toggle" method="POST" class="inline">
                    <button type="submit" class="text-gray-600 hover:text-gray-800 p-2" title="<%= producto.activo ? 'Desactivar' : 'Activar' %>">
                        <i class="fas <%= producto.activo ? 'fa-toggle-on' : 'fa-toggle-off' %>"></i>
                    </button>
                </form>
                <form action="/productos/<%= producto.id %>/eliminar" method="POST" class="inline" onsubmit="return confirm('¿Eliminar este producto permanentemente?')">
                    <button type="submit" class="text-red-600 hover:text-red-800 p-2" title="Eliminar">
                        <i class="fas fa-trash"></i>
                    </button>
                </form>
            </div>
        </div>
        <% }); %>
    <% } else { %>
        <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
            <i class="fas fa-box text-4xl mb-3 text-gray-300"></i>
            <p>No se encontraron productos</p>
        </div>
    <% } %>
</div>

<!-- VISTA DESKTOP: Tabla -->
<div class="hidden md:block bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Producto</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Descripción</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Precio Base</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
            </tr>
        </thead>
        <tbody id="tablaProductos">
            <% productos.forEach(producto => { %>
            <tr class="fila-producto hover:bg-gray-50 transition" 
                data-nombre="<%= producto.nombre.toLowerCase() %>" 
                data-descripcion="<%= (producto.descripcion || '').toLowerCase() %>"
                data-activo="<%= producto.activo ? 'activo' : 'inactivo' %>">
                <td class="px-6 py-4">
                    <div class="flex items-center">
                        <div class="h-10 w-10 rounded-lg bg-purple-100 flex items-center justify-center text-purple-600 font-bold mr-3">
                            <i class="fas fa-box"></i>
                        </div>
                        <span class="nombre-producto font-medium text-gray-900"><%= producto.nombre %></span>
                    </div>
                </td>
                <td class="px-6 py-4 text-sm text-gray-600 max-w-xs truncate"><%= producto.descripcion || '-' %></td>
                <td class="px-6 py-4 text-sm text-gray-900 text-right font-medium">S/ <%= Number(producto.precio_base).toFixed(2) %></td>
                <td class="px-6 py-4 text-center">
                    <% if (producto.activo) { %>
                        <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full font-medium">Activo</span>
                    <% } else { %>
                        <span class="bg-red-100 text-red-800 text-xs px-2 py-1 rounded-full font-medium">Inactivo</span>
                    <% } %>
                </td>
                <td class="px-6 py-4 text-right">
                    <div class="flex justify-end gap-2">
                        <a href="/productos/<%= producto.id %>" class="text-blue-600 hover:text-blue-800 p-2" title="Ver">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="/productos/<%= producto.id %>/editar" class="text-yellow-600 hover:text-yellow-800 p-2" title="Editar">
                            <i class="fas fa-edit"></i>
                        </a>
                        <form action="/productos/<%= producto.id %>/toggle" method="POST" class="inline">
                            <button type="submit" class="text-gray-600 hover:text-gray-800 p-2" title="<%= producto.activo ? 'Desactivar' : 'Activar' %>">
                                <i class="fas <%= producto.activo ? 'fa-toggle-on' : 'fa-toggle-off' %>"></i>
                            </button>
                        </form>
                        <form action="/productos/<%= producto.id %>/eliminar" method="POST" class="inline" onsubmit="return confirm('¿Eliminar este producto permanentemente?')">
                            <button type="submit" class="text-red-600 hover:text-red-800 p-2" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
            <% }); %>
        </tbody>
        <tbody id="sinResultadosProd" style="display: none;">
            <tr>
                <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                    <i class="fas fa-search text-4xl mb-3 text-gray-300"></i>
                    <p>No se encontraron productos con ese criterio</p>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<script>
    const buscadorProd = document.getElementById('buscadorProductos');
    const filtroActivoProd = document.getElementById('filtroActivoProd');
    const filasProd = document.querySelectorAll('.fila-producto');
    const sinResultadosProd = document.getElementById('sinResultadosProd');
    const tablaProductos = document.getElementById('tablaProductos');

    function filtrarProd() {
        const texto = buscadorProd.value.toLowerCase().trim();
        const estado = filtroActivoProd.value;
        let visibles = 0;

        filasProd.forEach(fila => {
            const nombre = fila.dataset.nombre;
            const descripcion = fila.dataset.descripcion;
            const activo = fila.dataset.activo;

            const coincideTexto = !texto || nombre.includes(texto) || descripcion.includes(texto);
            const coincideEstado = estado === 'todos' || activo === estado;

            if (coincideTexto && coincideEstado) {
                fila.style.display = '';
                visibles++;
            } else {
                fila.style.display = 'none';
            }
        });

        if (visibles === 0) {
            tablaProductos.style.display = 'none';
            sinResultadosProd.style.display = '';
        } else {
            tablaProductos.style.display = '';
            sinResultadosProd.style.display = 'none';
        }
    }

    buscadorProd.addEventListener('input', filtrarProd);
    filtroActivoProd.addEventListener('change', filtrarProd);

    buscadorProd.focus();
</script>