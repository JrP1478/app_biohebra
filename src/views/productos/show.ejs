<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-lg shadow">
        <div class="p-6 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg font-semibold">Detalle del Producto</h3>
            <div class="flex gap-2">
                <a href="/productos/<%= producto.id %>/editar" class="bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded-lg transition text-sm">
                    <i class="fas fa-edit mr-2"></i>Editar
                </a>
                <a href="/productos" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg transition text-sm">
                    Volver
                </a>
            </div>
        </div>
        
        <div class="p-6">
            <div class="flex items-center gap-4 mb-6">
                <div class="h-16 w-16 rounded-lg bg-purple-100 flex items-center justify-center text-purple-600 text-2xl">
                    <i class="fas fa-box"></i>
                </div>
                <div>
                    <h2 class="text-xl font-bold text-gray-800"><%= producto.nombre %></h2>
                    <span class="inline-block mt-1 <%= producto.activo ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %> text-xs px-3 py-1 rounded-full font-medium">
                        <%= producto.activo ? 'Activo' : 'Inactivo' %>
                    </span>
                </div>
            </div>

            <div class="space-y-4">
                <div class="bg-gray-50 p-4 rounded-lg">
                    <p class="text-sm text-gray-500 mb-1"><i class="fas fa-align-left w-5"></i>Descripción</p>
                    <p class="font-medium"><%= producto.descripcion || 'Sin descripción' %></p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                    <p class="text-sm text-gray-500 mb-1"><i class="fas fa-tag w-5"></i>Precio Base</p>
                    <p class="font-medium text-lg text-blue-600">S/ <%= Number(producto.precio_base).toFixed(2) %></p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-gray-50 p-4 rounded-lg">
                        <p class="text-sm text-gray-500 mb-1"><i class="fas fa-calendar w-5"></i>Registrado</p>
                        <p class="font-medium"><%= new Date(producto.created_at).toLocaleDateString('es-PE') %></p>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-lg">
                        <p class="text-sm text-gray-500 mb-1"><i class="fas fa-clock w-5"></i>Actualizado</p>
                        <p class="font-medium"><%= new Date(producto.updated_at).toLocaleDateString('es-PE') %></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>