<div class="flex items-center justify-center min-h-[60vh]">
    <div class="text-center max-w-md">
        <div class="mb-6">
            <% if (codigo === 404) { %>
                <i class="fas fa-search text-6xl text-gray-300 mb-4"></i>
            <% } else if (codigo === 403) { %>
                <i class="fas fa-lock text-6xl text-red-300 mb-4"></i>
            <% } else { %>
                <i class="fas fa-exclamation-triangle text-6xl text-yellow-300 mb-4"></i>
            <% } %>
        </div>
        <h1 class="text-6xl font-bold text-gray-300 mb-2"><%= codigo %></h1>
        <h2 class="text-2xl font-semibold text-gray-700 mb-3"><%= titulo %></h2>
        <p class="text-gray-500 mb-8"><%= mensaje %></p>
        <div class="flex gap-3 justify-center">
            <a href="/" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition">
                <i class="fas fa-home mr-2"></i>Dashboard
            </a>
            <button onclick="history.back()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-6 py-2 rounded-lg transition">
                <i class="fas fa-arrow-left mr-2"></i>Volver
            </button>
        </div>
    </div>
</div>