<div class="max-w-3xl mx-auto">
    <div class="bg-white rounded-lg shadow">
        <div class="p-6 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg font-semibold">Datos de la Empresa</h3>
            <a href="/empresa/editar" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition text-sm">
                <i class="fas fa-edit mr-2"></i>Editar
            </a>
        </div>
        
        <% if (empresa) { %>
        <div class="p-6">
            <div class="flex items-start gap-6 mb-6">
                <% if (empresa.logo) { %>
                <img src="<%= empresa.logo %>" alt="Logo" class="w-32 h-32 object-contain border rounded-lg">
                <% } else { %>
                <div class="w-32 h-32 bg-gray-100 border rounded-lg flex items-center justify-center text-gray-400">
                    <i class="fas fa-image text-3xl"></i>
                </div>
                <% } %>
                <div class="flex-1">
                    <h2 class="text-2xl font-bold text-gray-800 mb-2"><%= empresa.nombre %></h2>
                    <span class="inline-block bg-blue-100 text-blue-800 text-sm px-3 py-1 rounded-full font-medium">
                        RUC: <%= empresa.ruc %>
                    </span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-gray-50 p-4 rounded-lg">
                    <p class="text-sm text-gray-500 mb-1"><i class="fas fa-map-marker-alt w-5"></i>Dirección</p>
                    <p class="font-medium"><%= empresa.direccion || 'No especificada' %></p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                    <p class="text-sm text-gray-500 mb-1"><i class="fas fa-phone w-5"></i>Teléfono</p>
                    <p class="font-medium"><%= empresa.telefono || 'No especificado' %></p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                    <p class="text-sm text-gray-500 mb-1"><i class="fas fa-globe w-5"></i>Web</p>
                    <p class="font-medium">
                        <% if (empresa.web) { %>
                        <a href="https://<%= empresa.web %>" target="_blank" class="text-blue-600 hover:underline"><%= empresa.web %></a>
                        <% } else { %>
                        No especificada
                        <% } %>
                    </p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                    <p class="text-sm text-gray-500 mb-1"><i class="fas fa-calendar w-5"></i>Actualizado</p>
                    <p class="font-medium"><%= new Date(empresa.updated_at).toLocaleDateString('es-PE') %></p>
                </div>
            </div>
        </div>
        <% } else { %>
        <div class="p-12 text-center">
            <i class="fas fa-building text-4xl text-gray-300 mb-4"></i>
            <p class="text-gray-500 mb-4">No hay datos de empresa configurados</p>
            <a href="/empresa/editar" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition">
                Configurar ahora
            </a>
        </div>
        <% } %>
    </div>
</div>